<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sistem Layanan Siswa SMA</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
</head>
<body class="bg-gray-50 text-gray-800 font-sans antialiased pb-12">

    <!-- Header Navigation -->
    <header class="bg-blue-700 text-white shadow-lg sticky top-0 z-50">
        <div class="max-w-4xl mx-auto px-4 py-4 flex justify-between items-center">
            <div class="flex items-center space-x-3">
                <i class="fas fa-school text-2xl text-yellow-300"></i>
                <div>
                    <h1 class="font-bold text-lg leading-tight">Layanan Siswa SMA</h1>
                    <p class="text-xs text-blue-200">Aspirasi, Evaluasi & Tindak Lanjut</p>
                </div>
            </div>
            <button onclick="openModal()" class="bg-yellow-400 hover:bg-yellow-500 text-blue-900 font-bold px-3 py-2 rounded-lg text-sm transition shadow flex items-center gap-1">
                <i class="fas fa-plus"></i> <span class="hidden sm:inline">Kirim</span> Saran
            </button>
        </div>
    </header>

    <!-- Main Container -->
    <main class="max-w-4xl mx-auto px-4 mt-6">
        
        <!-- Hero & Info Section -->
        <div class="bg-white rounded-xl shadow-sm p-5 border border-gray-100 mb-6">
            <h2 class="text-lg font-bold text-gray-800 mb-2">Transparansi Layanan Sekolah</h2>
            <p class="text-sm text-gray-600 leading-relaxed mb-4">
                Wadah resmi siswa untuk menyampaikan saran dan kritik terkait Kegiatan Belajar Mengajar (KBM) serta Sarana & Prasarana. Seluruh evaluasi dan status tindak lanjut dapat dipantau oleh publik secara terbuka.
            </p>
            <div class="grid grid-cols-3 gap-3 text-center border-t pt-4">
                <div class="bg-blue-50 p-3 rounded-lg">
                    <span class="block text-2xl font-extrabold text-blue-700" id="total-count">0</span>
                    <span class="text-xs text-gray-500">Total Masukan</span>
                </div>
                <div class="bg-amber-50 p-3 rounded-lg">
                    <span class="block text-2xl font-extrabold text-amber-600" id="process-count">0</span>
                    <span class="text-xs text-gray-500">Diproses</span>
                </div>
                <div class="bg-emerald-50 p-3 rounded-lg">
                    <span class="block text-2xl font-extrabold text-emerald-600" id="done-count">0</span>
                    <span class="text-xs text-gray-500">Tindak Lanjut Selesai</span>
                </div>
            </div>
        </div>

        <!-- Filter Options -->
        <div class="flex flex-wrap gap-2 mb-6">
            <button onclick="filterCategory('All')" class="filter-btn bg-blue-700 text-white px-4 py-2 rounded-full text-xs font-semibold shadow-sm">Semua</button>
            <button onclick="filterCategory('KBM')" class="filter-btn bg-white border border-gray-300 text-gray-700 px-4 py-2 rounded-full text-xs font-semibold shadow-sm hover:bg-gray-100">Kegiatan Belajar (KBM)</button>
            <button onclick="filterCategory('Sarana')" class="filter-btn bg-white border border-gray-300 text-gray-700 px-4 py-2 rounded-full text-xs font-semibold shadow-sm hover:bg-gray-100">Sarana Pendidikan</button>
        </div>

        <!-- Feed List -->
        <div id="feedback-list" class="space-y-4">
            <!-- Cards generated dynamically via JavaScript -->
        </div>
    </main>

    <!-- Modal Form Kirim Saran -->
    <div id="modal" class="fixed inset-0 bg-black/50 backdrop-blur-sm hidden z-50 flex items-center justify-center p-4">
        <div class="bg-white rounded-2xl max-w-md w-full p-6 shadow-2xl transform transition-all">
            <div class="flex justify-between items-center mb-4 border-b pb-3">
                <h3 class="text-lg font-bold text-gray-800">Formulir Kirim Saran & Kritik</h3>
                <button onclick="closeModal()" class="text-gray-400 hover:text-gray-600"><i class="fas fa-times text-xl"></i></button>
            </div>
            <form id="feedback-form" onsubmit="submitForm(event)" class="space-y-4">
                <div>
                    <label class="block text-xs font-bold text-gray-700 mb-1">Nama Siswa (Boleh Anonim)</label>
                    <input type="text" id="input-name" placeholder="Atau biarkan 'Anonim'" class="w-full border rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-blue-500 outline-none">
                </div>
                <div>
                    <label class="block text-xs font-bold text-gray-700 mb-1">Kategori Layanan *</label>
                    <select id="input-category" required class="w-full border rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-blue-500 outline-none">
                        <option value="KBM">Kegiatan Belajar Mengajar (KBM)</option>
                        <option value="Sarana">Sarana Pendidikan & Fasilitas</option>
                    </select>
                </div>
                <div>
                    <label class="block text-xs font-bold text-gray-700 mb-1">Topik / Judul *</label>
                    <input type="text" id="input-topic" required placeholder="Contoh: AC Kelas XI IPA 2 Mati" class="w-full border rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-blue-500 outline-none">
                </div>
                <div>
                    <label class="block text-xs font-bold text-gray-700 mb-1">Detail Saran / Kritik *</label>
                    <textarea id="input-detail" required rows="3" placeholder="Jelaskan kendala atau masukan Anda secara jelas..." class="w-full border rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-blue-500 outline-none"></textarea>
                </div>
                <div class="pt-2 flex justify-end gap-2">
                    <button type="button" onclick="closeModal()" class="px-4 py-2 border rounded-lg text-sm font-semibold text-gray-600 hover:bg-gray-100">Batal</button>
                    <button type="submit" class="px-5 py-2 bg-blue-700 text-white rounded-lg text-sm font-semibold hover:bg-blue-800 shadow">Kirimkan</button>
                </div>
            </form>
        </div>
    </div>

    <!-- JavaScript Application Logic -->
    <script>
        let feedbackData = [
            {
                id: 1,
                name: "Siswa Kelas XII",
                category: "KBM",
                topic: "Jadwal Ulangan Harian Berturut-turut",
                detail: "Mohon agar guru-guru berkoordinasi sehingga dalam satu hari tidak ada lebih dari dua ulangan harian.",
                status: "Dievaluasi",
                evaluation: "Kurikulum telah meninjau keluhan dan menemukan penumpukan jadwal ulangan di akhir bulan.",
                action: "Menyiapkan kalender asesmen bersama untuk membatasi maksimal 2 tes per hari.",
                progress: 60,
                date: "28 Sep 2026"
            },
            {
                id: 2,
                name: "Anonim",
                category: "Sarana",
                topic: "Proyektor Lab Komputer Redup",
                detail: "Proyektor di Lab 2 sudah sangat buram sehingga materi presentasi guru sulit dibaca dari belakang.",
                status: "Selesai",
                evaluation: "Tim sarpras memeriksa unit dan mengonfirmasi bahwa lampu proyektor telah melewati batas jam pemakaian.",
                action: "Pengantian unit bohlam proyektor baru telah selesai dilaksanakan.",
                progress: 100,
                date: "25 Sep 2026"
            }
        ];

        let activeCategory = 'All';

        function renderList() {
            const container = document.getElementById('feedback-list');
            container.innerHTML = '';

            const filtered = activeCategory === 'All' 
                ? feedbackData 
                : feedbackData.filter(item => item.category === activeCategory);

            if (filtered.length === 0) {
                container.innerHTML = `<div class="text-center py-10 text-gray-400">Belum ada saran untuk kategori ini.</div>`;
                updateCounts();
                return;
            }

            filtered.forEach(item => {
                const statusColor = item.status === 'Selesai' ? 'bg-emerald-100 text-emerald-800 border-emerald-300' :
                                    item.status === 'Dievaluasi' ? 'bg-amber-100 text-amber-800 border-amber-300' :
                                    'bg-blue-100 text-blue-800 border-blue-300';

                const card = document.createElement('div');
                card.className = "bg-white rounded-xl shadow-sm border border-gray-100 p-5 space-y-4 hover:shadow-md transition";
                card.innerHTML = `
                    <div class="flex justify-between items-start">
                        <div>
                            <span class="inline-block px-2.5 py-0.5 rounded-full text-xs font-semibold bg-gray-100 text-gray-600 mb-2">${item.category === 'KBM' ? 'Kegiatan Belajar' : 'Sarana Pendidikan'}</span>
                            <h3 class="font-bold text-gray-800 text-base">${item.topic}</h3>
                            <p class="text-xs text-gray-400 mt-0.5">Oleh: ${item.name} • ${item.date}</p>
                        </div>
                        <span class="px-3 py-1 rounded-full text-xs font-bold border ${statusColor}">${item.status}</span>
                    </div>

                    <p class="text-sm text-gray-700 bg-gray-50 p-3 rounded-lg border-l-4 border-blue-500">${item.detail}</p>

                    <!-- Section Evaluasi & Tindak Lanjut -->
                    <div class="bg-gray-50/80 rounded-xl p-4 border border-gray-200/60 space-y-3">
                        <div class="flex justify-between items-center">
                            <h4 class="text-xs font-bold text-gray-700 uppercase tracking-wider flex items-center gap-1.5">
                                <i class="fas fa-clipboard-check text-blue-600"></i> Evaluasi & Tindak Lanjut Sekolah
                            </h4>
                            <span class="text-xs font-extrabold text-blue-700">${item.progress}%</span>
                        </div>

                        <!-- Progress Bar -->
                        <div class="w-full bg-gray-200 rounded-full h-2">
                            <div class="bg-blue-600 h-2 rounded-full transition-all duration-500" style="width: ${item.progress}%"></div>
                        </div>

                        <div class="text-xs space-y-1.5 text-gray-600">
                            <p><strong class="text-gray-800">Evaluasi:</strong> ${item.evaluation || 'Sedang dikaji oleh tim terkait.'}</p>
                            <p><strong class="text-gray-800">Rencana Aksinya:</strong> ${item.action || 'Menunggu keputusan rapat teknis.'}</p>
                        </div>
                    </div>
                `;
                container.appendChild(card);
            });

            updateCounts();
        }

        function updateCounts() {
            document.getElementById('total-count').innerText = feedbackData.length;
            document.getElementById('process-count').innerText = feedbackData.filter(x => x.status !== 'Selesai').length;
            document.getElementById('done-count').innerText = feedbackData.filter(x => x.status === 'Selesai').length;
        }

        function filterCategory(cat) {
            activeCategory = cat;
            renderList();
        }

        function openModal() { document.getElementById('modal').classList.remove('hidden'); }
        function closeModal() { document.getElementById('modal').classList.add('hidden'); }

        function submitForm(e) {
            e.preventDefault();
            const name = document.getElementById('input-name').value.trim() || 'Anonim';
            const category = document.getElementById('input-category').value;
            const topic = document.getElementById('input-topic').value;
            const detail = document.getElementById('input-detail').value;

            const newItem = {
                id: Date.now(),
                name: name,
                category: category,
                topic: topic,
                detail: detail,
                status: "Diproses",
                evaluation: "Laporan telah masuk ke sistem dan dalam antrean peninjauan sekolah.",
                action: "Penjadwalan inspeksi/koordinasi lapangan.",
                progress: 20,
                date: "Baru Saja"
            };

            feedbackData.unshift(newItem);
            renderList();
            closeModal();
            document.getElementById('feedback-form').reset();
        }

        // Initial Render
        renderList();
    </script>
</body>
</html>
